
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Little Task For Eash</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #ffd6e7, #d8ffe9, #ffe9d2);
    font-family: 'Fredoka', sans-serif;
    overflow-x: hidden;
    padding: 20px;
}

.container {
    width: 100%;
    max-width: 430px;
    background: rgba(255,255,255,0.75);
    border: 2px solid white;
    border-radius: 30px;
    padding: 30px 22px;
    text-align: center;
    box-shadow: 0 15px 40px #d88eaa45;
    animation: appear 0.8s ease;
}

@keyframes appear {
    from { opacity: 0; transform: translateY(35px) scale(.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

h1 {
    color: #ef77a5;
    font-size: 38px;
    margin-bottom: 15px;
}

p {
    color: #66756c;
    font-size: 17px;
    line-height: 1.6;
}

.emoji {
    font-size: 65px;
    margin: 15px 0;
    animation: bounce 2s infinite;
}

@keyframes bounce {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
}

button {
    border: none;
    background: linear-gradient(135deg, #ff8fba, #a3e8b8);
    color: white;
    font-family: inherit;
    font-size: 18px;
    font-weight: 700;
    padding: 14px 35px;
    border-radius: 30px;
    margin-top: 25px;
    cursor: pointer;
    box-shadow: 0 5px 15px #e99bbd55;
    transition: .3s;
}

button:active {
    transform: scale(.94);
}

.screen {
    display: none;
}

.screen.active {
    display: block;
    animation: appear .6s ease;
}

.subtitle {
    background: #ffe6f0;
    padding: 14px;
    border-radius: 18px;
    margin: 15px 0 22px;
    color: #ba6489;
}

.task {
    display: flex;
    align-items: center;
    text-align: left;
    gap: 12px;
    padding: 15px 12px;
    margin: 12px 0;
    background: #f0fff4;
    border: 2px solid #d0f2dc;
    border-radius: 18px;
    cursor: pointer;
    transition: .25s;
    color: #52675a;
    font-size: 15px;
}

.task:nth-child(even) {
    background: #fff0f6;
    border-color: #ffd5e5;
}

.task.selected {
    border: 2px solid #ee83ad;
    background: #ffe0ed;
    transform: scale(1.03);
}

.tick {
    min-width: 25px;
    height: 25px;
    border: 2px solid #ed8eb3;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
}

.selected .tick {
    background: #ed83ad;
}

.task-text {
    flex: 1;
    line-height: 1.4;
}

.final-emoji {
    font-size: 95px;
    animation: thumbs 1.2s infinite ease-in-out;
    margin: 25px 0;
}

@keyframes thumbs {
    0%,100% { transform: rotate(-12deg) scale(1); }
    50% { transform: rotate(12deg) scale(1.2); }
}

.small {
    font-size: 14px;
    margin-top: 15px;
    color: #a0788d;
}

.confetti {
    position: fixed;
    top: -20px;
    font-size: 22px;
    pointer-events: none;
    animation: fall 3s linear forwards;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(600deg);
        opacity: 0;
    }
}
</style>
</head>

<body>

<div class="container">

    <!-- WELCOME SCREEN -->
    <div class="screen active" id="welcome">

        <div class="emoji">🌸</div>

        <h1>Hey Eash!</h1>

        <p>
        Hope you aren't too concerned about seeing this.
        Don't worry, it's nothing serious...
        Probably. 😂
        </p>

        <button onclick="nextScreen('tasks')">
            Let's Go! 💗
        </button>

        <p class="small">A little surprise awaits you ✨</p>

    </div>


    <!-- TASK SCREEN -->
    <div class="screen" id="tasks">

        <div class="emoji">😈</div>

        <h1>Your Mission!</h1>

        <div class="subtitle">
            I have some tasks for you!
            Choose wisely... 👀
        </div>

        <div class="task" onclick="choose(this)">
            <div class="tick"></div>
            <div class="task-text">
                <b>A.</b> Lip-sync on any song of your choice. 🎵
            </div>
        </div>

        <div class="task" onclick="choose(this)">
            <div class="tick"></div>
            <div class="task-text">
                <b>B.</b> Lip-sync on a song chosen by me. 💀
            </div>
        </div>

        <div class="task" onclick="choose(this)">
            <div class="tick"></div>
            <div class="task-text">
                <b>C.</b> Accept Option A without negotiation. 😂
            </div>
        </div>

        <div class="task" onclick="choose(this)">
            <div class="tick"></div>
            <div class="task-text">
                <b>D.</b> Reject all options except B. 😈
            </div>
        </div>

        <p class="small">Tap your selected option ☝️</p>

    </div>


    <!-- FINAL SCREEN -->
    <div class="screen" id="final">

        <div class="emoji">🎉</div>

        <h1>Mission Accepted!</h1>

        <div class="final-emoji">👍</div>

        <p style="font-size:20px; color:#e77fa7; font-weight:700;">
            Enjoy your task! 💗
        </p>

        <p style="margin-top:12px;">
            I hope you do it soon, and we'll see how it goes! 😂
        </p>

        <div class="subtitle" id="result">
            Good luck! 🌷
        </div>

        <p class="small">No excuses now! 😈</p>

    </div>

</div>


<script>

function nextScreen(id) {

    document.querySelectorAll('.screen').forEach(s => {
        s.classList.remove('active');
    });

    document.getElementById(id).classList.add('active');

}

function choose(element) {

    document.querySelectorAll('.task').forEach(t => {
        t.classList.remove('selected');
        t.querySelector('.tick').innerHTML = '';
    });

    element.classList.add('selected');
    element.querySelector('.tick').innerHTML = '✓';

    const option = element.querySelector('b').innerText;

    document.getElementById('result').innerText =
        'Your selected option: ' + option + ' 💗';

    setTimeout(() => {
        nextScreen('final');
        confetti();
    }, 700);

}

function confetti() {

    const symbols = ['💗', '🌸', '✨', '💕', '🎀'];

    for(let i = 0; i < 35; i++) {

        let item = document.createElement('div');

        item.className = 'confetti';
        item.innerText = symbols[
            Math.floor(Math.random() * symbols.length)
        ];

        item.style.left = Math.random() * 100 + 'vw';
        item.style.animationDelay = Math.random() * 2 + 's';

        document.body.appendChild(item);

        setTimeout(() => item.remove(), 5000);

    }

}

</script>

</body>
</html>
